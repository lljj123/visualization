Panels:
  - Class: rviz/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Map1
        - /RobotModel1
        - /Current Path1
        - /Waypoints1
        - /Camera1
      Splitter Ratio: 0.55
    Tree Height: 500
  - Class: rviz_vln_panel/VlnStatusPanel
    Name: VLN Status
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 1
      Class: rviz/Map
      Color Scheme: map
      Draw Behind: true
      Enabled: true
      Name: Map
      Topic: /map
      Unreliable: false
      Value: true
    - Alpha: 1
      Class: rviz/RobotModel
      Collision Enabled: false
      Enabled: true
      Name: RobotModel
      Robot Description: robot_description
      Update Interval: 0
      Value: true
      Visual Enabled: true
    - Class: rviz/Path
      Color: 31; 69; 181
      Enabled: true
      Head Diameter: 0.12
      Head Length: 0.08
      Length: 0.18
      Line Style: Billboards
      Line Width: 0.06
      Name: Current Path
      Offset:
        X: 0
        Y: 0
        Z: 0.04
      Pose Color: 31; 69; 181
      Pose Style: None
      Radius: 0.03
      Shaft Diameter: 0.05
      Shaft Length: 0.12
      Topic: /current_path
      Unreliable: false
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /waypoints/markers
      Name: Waypoints
      Namespaces: {}
      Queue Size: 100
      Value: true
    - Class: rviz/Image
      Enabled: true
      Image Topic: /camera/rgb/image_raw
      Max Value: 1
      Median window: 5
      Min Value: 0
      Name: Camera
      Normalize Range: true
      Queue Size: 2
      Transport Hint: raw
      Unreliable: false
      Value: true
  Enabled: true
  Global Options:
    Background Color: 42; 46; 50
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
      Hide Inactive Objects: true
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
    - Class: rviz/SetInitialPose
      Topic: /initialpose
    - Class: rviz/SetGoal
      Topic: /move_base_simple/goal
  Views:
    Current:
      Angle: 0
      Class: rviz/TopDownOrtho
      Name: Top Down
      Near Clip Distance: 0.01
      Scale: 25
      Target Frame: <Fixed Frame>
      X: 1.8
      Y: 1.7
    Saved: ~
Window Geometry:
  Height: 1000
  Width: 1600
